{
  "expo": {
    "name": "Watch Face",
    "slug": "watch-face",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "watchface",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.olateju.watchface",
      "supportsTablet": false,
      "infoPlist": {}
    },
    "android": {
      "package": "com.olateju.watchface",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1E293B"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E293B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6112d0c8-03e3-4df3-a4a8-4aa5173b62b1"
      }
    },
    "owner": "tejcodes"
  }
}
